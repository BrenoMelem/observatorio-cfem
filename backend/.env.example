# Copie para .env na raiz do repositório e ajuste. O .env não é versionado; não grave senhas reais aqui.

# Pasta do pacote publicado (observações e indicadores.json). Sem Docker, vale a partir da raiz do repositório.
OBS_PUBLICADO_DIR=output/observatorio/publicado

# Docker compose: pasta do computador montada como pacote publicado dentro do contêiner.
OBS_PUBLICADO_HOST=./output/observatorio/publicado

# PostgreSQL dos dados de usuários (ADR-016); nenhum código o usa ainda.
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=observatorio
# Sem Docker, a API leria a conexão daqui (com Docker, o compose monta a URL):
DATABASE_URL=
